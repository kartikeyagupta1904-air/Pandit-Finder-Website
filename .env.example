# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# REQUIRED in production: a long random string (32+ chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Storage locations (relative to the project folder)
DATABASE_PATH=data/pandit-finder.db
UPLOAD_DIR=uploads

# Set to 1 when running behind a reverse proxy / HTTPS load balancer
TRUST_PROXY=0

# Show profiles created by `npm run seed` (labelled "Sample profile"). Set to 0 in production.
SHOW_SAMPLE_DATA=1

# Max login/register attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=10

# Used by `npm run create-admin` (or you will be prompted). Do not keep the password here afterwards.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Optional password for sample accounts created by `npm run seed` (random if empty)
SEED_PASSWORD=

# ---- Optional: Razorpay online payments (leave empty for the pay-later workflow) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Optional: email notifications (also run `npm install nodemailer`) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
